{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/jobs/(.+)",
      "destination": "/api/jobs?jobId=$1"
    },
    {
      "source": "/radar",
      "destination": "/radar.html"
    },
    {
      "source": "/careers",
      "destination": "/jobs.html"
    }
  ]
}